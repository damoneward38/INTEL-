from __future__ import annotations

import hashlib
import json
import mimetypes
import os
import re
import shutil
import uuid
import zipfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import pandas as pd
from fastapi import FastAPI, File, HTTPException, UploadFile
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field

BASE = Path(__file__).resolve().parents[1]
DATA = BASE / "data"
UPLOADS = DATA / "uploads"
EXTRACTED = DATA / "extracted"
AUDIT = DATA / "audit.jsonl"

MAX_FILE_BYTES = 100 * 1024 * 1024
MAX_ARCHIVE_FILES = 2000
MAX_ARCHIVE_EXPANDED = 500 * 1024 * 1024
ALLOWED_EXTENSIONS = {
    ".pdf", ".docx", ".txt", ".md", ".csv", ".tsv",
    ".xlsx", ".xls", ".json", ".ipynb", ".zip",
    ".pdb", ".cif", ".fasta", ".fa", ".fastq",
    ".fq", ".sdf", ".mol", ".xyz", ".py", ". R",
    ".js", ".ts", ".html", ".xml", ".yaml", ".yml"
}

for directory in (UPLOADS, EXTRACTED):
    directory.mkdir(parents=True, exist_ok=True)

app = FastAPI(
    title="אינטל-All-Upload",
    version="1.0.0",
    description="Local-first scientific file ingestion and research analysis."
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["GET", "POST"],
    allow_headers=["*"],
)


def audit(event: dict[str, Any]) -> None:
    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        **event,
    }
    with AUDIT.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, ensure_ascii=False) + "\n")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def safe_name(name: str) -> str:
    name = Path(name or "upload.bin").name
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name)
    return name[:180] or "upload.bin"


def extract_text(path: Path, extension: str) -> str:
    if extension == ".pdf":
        from pypdf import PdfReader
        reader = PdfReader(str(path))
        return "\n".join(page.extract_text() or "" for page in reader.pages)

    if extension == ".docx":
        from docx import Document
        doc = Document(str(path))
        return "\n".join(p.text for p in doc.paragraphs)

    if extension in {".csv", ".tsv"}:
        delimiter = "\t" if extension == ".tsv" else ","
        frame = pd.read_csv(path, sep=delimiter, nrows=10000)
        return frame.to_csv(index=False)

    if extension in {".xlsx", ".xls"}:
        sheets = pd.read_excel(path, sheet_name=None)
        return "\n\n".join(
            f"## {name}\n{frame.head(10000).to_csv(index=False)}"
            for name, frame in sheets.items()
        )

    if extension in {".json", ".ipynb"}:
        data = json.loads(path.read_text(encoding="utf-8"))
        if extension == ".ipynb":
            cells = data.get("cells", [])
            return "\n".join(
                "".join(cell.get("source", []))
                for cell in cells
            )
        return json.dumps(data, ensure_ascii=False, indent=2)

    if extension in {
        ".txt", ".md", ".py", ".r", ".js", ".ts",
        ".html", ".xml", ".yaml", ".yml", ".pdb",
        ".cif", ".fasta", ".fa", ".fastq", ".fq",
        ".sdf", ".mol", ".xyz"
    }:
        return path.read_text(encoding="utf-8", errors="replace")

    return ""


def inspect_csv(text: str) -> dict[str, Any]:
    try:
        from io import StringIO
        frame = pd.read_csv(StringIO(text))
        missing = int(frame.isna().sum().sum())
        total = int(frame.size)
        return {
            "rows": int(frame.shape[0]),
            "columns": int(frame.shape[1]),
            "column_names": list(map(str, frame.columns)),
            "missing_cells": missing,
            "missing_fraction": round(missing / total, 4) if total else 0,
            "duplicate_rows": int(frame.duplicated().sum()),
        }
    except Exception as exc:
        return {"inspection_error": str(exc)}


def analyze_document(text: str, extension: str) -> dict[str, Any]:
    words = re.findall(r"\b[\w'-]+\b", text)
    lower = text.lower()

    flags: list[dict[str, str]] = []
    recommendations: list[dict[str, str]] = []

    checks = {
        "sample_size": ["sample size", "participants", "subjects", "n ="],
        "randomization": ["randomized", "randomised", "randomization", "randomisation"],
        "blinding": ["blinded", "blind", "double-blind", "double blind"],
        "controls": ["control group", "control condition", "placebo", "negative control"],
        "limitations": ["limitations", "limitation", "study limitations"],
        "ethics": ["irb", "ethics approval", "ethical approval", "informed consent"],
        "statistics": ["confidence interval", "p-value", "p value", "standard deviation"],
        "preregistration": ["preregistered", "pre-registered", "clinicaltrials.gov", "osf.io"],
    }

    found = {key: any(term in lower for term in terms)
             for key, terms in checks.items()}

    for key, present in found.items():
        if not present:
            flags.append({
                "code": f"NOT_DETECTED_{key.upper()}",
                "severity": "review",
                "message": f"No explicit {key.replace('_', ' ')} information detected. This may be absent or expressed differently."
            })

    if not found["controls"]:
        recommendations.append({
            "category": "design",
            "priority": "high",
            "action": "Review whether suitable control conditions are needed and scientifically justified."
        })

    if not found["statistics"]:
        recommendations.append({
            "category": "analysis",
            "priority": "medium",
            "action": "Document the statistical methods, uncertainty estimates, and analysis assumptions."
        })

    if not found["limitations"]:
        recommendations.append({
            "category": "reporting",
            "priority": "medium",
            "action": "Add a limitations section describing bias, uncertainty, and generalizability."
        })

    if not found["ethics"]:
        recommendations.append({
            "category": "ethics",
            "priority": "high",
            "action": "Have an appropriate human reviewer verify whether ethics approval, consent, or an exemption applies."
        })

    detected = sum(found.values())
    score = round(100 * detected / len(found))

    return {
        "word_count": len(words),
        "character_count": len(text),
        "detected_sections": found,
        "heuristic_completeness_score": score,
        "score_warning": "This is a keyword-based completeness indicator, not a scientific validity or publication-readiness score.",
        "flags": flags,
        "recommendations": recommendations,
        "data_profile": inspect_csv(text) if extension in {".csv", ".tsv"} else None,
    }


def inspect_archive(path: Path, destination: Path) -> dict[str, Any]:
    extracted_files = []
    total_size = 0

    with zipfile.ZipFile(path) as archive:
        members = archive.infolist()

        if len(members) > MAX_ARCHIVE_FILES:
            raise HTTPException(413, "Archive contains too many files.")

        for member in members:
            candidate = Path(member.filename)

            if candidate.is_absolute() or ".." in candidate.parts:
                raise HTTPException(400, "Unsafe archive path detected.")

            if member.is_dir():
                continue

            total_size += member.file_size
            if total_size > MAX_ARCHIVE_EXPANDED:
                raise HTTPException(413, "Expanded archive exceeds size limit.")

            target = destination / candidate
            target.resolve().relative_to(destination.resolve())
            target.parent.mkdir(parents=True, exist_ok=True)

            with archive.open(member) as source, target.open("wb") as output:
                shutil.copyfileobj(source, output)

            extracted_files.append({
                "path": str(target.relative_to(destination)),
                "bytes": member.file_size,
            })

    return {
        "archive_file_count": len(extracted_files),
        "expanded_bytes": total_size,
        "files": extracted_files,
    }


@app.get("/health")
async def health():
    return {
        "status": "ok",
        "service": "intel-all-upload",
        "storage": "local",
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


@app.post("/api/v1/upload")
async def upload(file: UploadFile = File(...)):
    original_name = safe_name(file.filename or "upload.bin")
    extension = Path(original_name).suffix.lower()

    if extension not in ALLOWED_EXTENSIONS:
        raise HTTPException(415, f"Unsupported file extension: {extension}")

    upload_id = str(uuid.uuid4())
    target = UPLOADS / f"{upload_id}_{original_name}"

    size = 0
    digest = hashlib.sha256()

    try:
        with target.open("wb") as output:
            while chunk := await file.read(1024 * 1024):
                size += len(chunk)

                if size > MAX_FILE_BYTES:
                    raise HTTPException(413, "File exceeds 100 MB limit.")

                digest.update(chunk)
                output.write(chunk)

        checksum = digest.hexdigest()
        result: dict[str, Any] = {
            "upload_id": upload_id,
            "filename": original_name,
            "extension": extension,
            "mime_type": mimetypes.guess_type(original_name)[0] or "application/octet-stream",
            "size_bytes": size,
            "sha256": checksum,
            "storage": "local",
            "analysis_status": "completed",
        }

        if extension == ".zip":
            extraction_dir = EXTRACTED / upload_id
            extraction_dir.mkdir(parents=True, exist_ok=True)
            result["archive"] = inspect_archive(target, extraction_dir)
            result["analysis_status"] = "archive_extracted_review_required"
        else:
            text = extract_text(target, extension)
            text_path = EXTRACTED / f"{upload_id}.txt"
            text_path.write_text(text, encoding="utf-8")

            result["extracted_text_bytes"] = len(text.encode("utf-8"))
            result["analysis"] = analyze_document(text, extension)

        audit({
            "event": "upload_processed",
            "upload_id": upload_id,
            "filename": original_name,
            "sha256": checksum,
            "size_bytes": size,
            "extension": extension,
        })

        return JSONResponse(result)

    except HTTPException:
        target.unlink(missing_ok=True)
        raise
    except zipfile.BadZipFile:
        target.unlink(missing_ok=True)
        raise HTTPException(400, "Invalid ZIP archive.")
    except Exception as exc:
        target.unlink(missing_ok=True)
        audit({
            "event": "upload_failed",
            "upload_id": upload_id,
            "error": str(exc),
        })
        raise HTTPException(422, f"File processing failed: {exc}")


class PlannerRequest(BaseModel):
    research_question: str = Field(min_length=10, max_length=5000)
    domain: str = Field(default="general", max_length=100)
    context: str = Field(default="", max_length=20000)


@app.post("/api/v1/plan")
async def create_plan(request: PlannerRequest):
    """
    Deterministic starter planner.
    Connect a locally hosted LLM behind this endpoint only after validating
    its output against a strict schema and source-grounding requirements.
    """
    plan = {
        "research_question": request.research_question,
        "domain": request.domain,
        "status": "draft_requires_expert_review",
        "steps": [
            {
                "stage": "hypothesis",
                "action": "Define a testable hypothesis and primary outcome."
            },
            {
                "stage": "data",
                "action": "Identify data provenance, inclusion criteria, missingness, and permissions."
            },
            {
                "stage": "design",
                "action": "Review controls, sample-size rationale, randomization, and bias risks."
            },
            {
                "stage": "analysis",
                "action": "Predefine statistical methods and sensitivity analyses."
            },
            {
                "stage": "validation",
                "action": "Validate results independently and document uncertainty."
            },
            {
                "stage": "reporting",
                "action": "Prepare a transparent report with reproducible methods and citations."
            },
        ],
        "context_received": bool(request.context.strip()),
        "execution_enabled": False,
    }

    audit({
        "event": "research_plan_created",
        "domain": request.domain,
    })

    return plan


@app.get("/api/v1/audit")
async def get_audit():
    if not AUDIT.exists():
        return {"events": []}

    events = []
    for line in AUDIT.read_text(encoding="utf-8").splitlines()[-500:]:
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue

    return {"events": events}


