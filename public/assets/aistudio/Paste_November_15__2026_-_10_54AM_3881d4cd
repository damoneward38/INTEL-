import React, { useState } from "react";
import { createRoot } from "react-dom/client";
import "./style.css";

type UploadResult = {
  upload_id: string;
  filename: string;
  extension: string;
  mime_type: string;
  size_bytes: number;
  sha256: string;
  analysis_status: string;
  analysis?: {
    word_count: number;
    heuristic_completeness_score: number;
    score_warning: string;
    flags: { code: string; severity: string; message: string }[];
    recommendations: { category: string; priority: string; action: string }[];
    data_profile?: Record<string, unknown> | null;
  };
  archive?: Record<string, unknown>;
};

const API = import.meta.env.VITE_API_URL || "http://localhost:8000";

function App() {
  const [file, setFile] = useState<File | null>(null);
  const [result, setResult] = useState<UploadResult | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [dragging, setDragging] = useState(false);

  async function upload(selected: File) {
    setFile(selected);
    setResult(null);
    setError("");
    setBusy(true);

    try {
      const body = new FormData();
      body.append("file", selected);

      const response = await fetch(`${API}/api/v1/upload`, {
        method: "POST",
        body
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.detail || "Upload failed");
      }

      setResult(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unknown upload error");
    } finally {
      setBusy(false);
    }
  }

  function handleDrop(event: React.DragEvent<HTMLDivElement>) {
    event.preventDefault();
    setDragging(false);
    const selected = event.dataTransfer.files?.[0];
    if (selected) void upload(selected);
  }

  return (
    <main className="shell">
      <header className="topbar">
        <div className="brand">
          <span className="brand-mark">א</span>
          <div>
            <strong>אינטל</strong>
            <small>ALL-UPLOAD RESEARCH INTELLIGENCE</small>
          </div>
        </div>
        <span className="local-status">LOCAL INGESTION</span>
      </header>

      <section className="hero">
        <p className="eyebrow">UNIVERSAL RESEARCH WORKSPACE</p>
        <h1>Turn your data into your next research step.</h1>
        <p className="subtitle">
          Upload research documents, datasets, notebooks, code, sequences,
          and supported scientific files.
        </p>
      </section>

      <section
        className={`dropzone ${dragging ? "dragging" : ""}`}
        onDragOver={event => {
          event.preventDefault();
          setDragging(true);
        }}
        onDragLeave={() => setDragging(false)}
        onDrop={handleDrop}
      >
        <div className="upload-icon">↑</div>
        <h2>Drop a research file here</h2>
        <p>Or select a file from your computer</p>
        <label className="upload-button">
          Choose file
          <input
            type="file"
            onChange={event => {
              const selected = event.target.files?.[0];
              if (selected) void upload(selected);
            }}
          />
        </label>
        <small>Maximum 100 MB · ZIP expansion limited · Local storage</small>
        {file && <p className="selected-file">{file.name}</p>}
      </section>

      {busy && <p className="notice">Processing file…</p>}
      {error && <p className="error">{error}</p>}

      {result && (
        <section className="results">
          <div className="result-heading">
            <div>
              <p className="eyebrow">INGESTION COMPLETE</p>
              <h2>{result.filename}</h2>
            </div>
            <span className="success">PROCESSED</span>
          </div>

          <div className="metrics">
            <article>
              <small>FILE TYPE</small>
              <strong>{result.extension}</strong>
            </article>
            <article>
              <small>FILE SIZE</small>
              <strong>{(result.size_bytes / 1024 / 1024).toFixed(2)} MB</strong>
            </article>
            <article>
              <small>WORDS EXTRACTED</small>
              <strong>{result.analysis?.word_count ?? "—"}</strong>
            </article>
            <article>
              <small>COMPLETENESS INDICATOR</small>
              <strong>
                {result.analysis
                  ? `${result.analysis.heuristic_completeness_score}/100`
                  : "—"}
              </strong>
            </article>
          </div>

          {result.analysis && (
            <>
              <p className="warning">{result.analysis.score_warning}</p>

              <h3>Review flags</h3>
              {result.analysis.flags.length === 0 ? (
                <p>No keyword-based review flags were detected.</p>
              ) : (
                <div className="recommendations">
                  {result.analysis.flags.map(flag => (
                    <article className="recommendation" key={flag.code}>
                      <span className="priority">{flag.severity}</span>
                      <strong>{flag.code}</strong>
                      <p>{flag.message}</p>
                    </article>
                  ))}
                </div>
              )}

              <h3>Improvement suggestions</h3>
              <div className="recommendations">
                {result.analysis.recommendations.map((item, index) => (
                  <article className="recommendation" key={index}>
                    <span className="priority">{item.priority}</span>
                    <strong>{item.category}</strong>
                    <p>{item.action}</p>
                  </article>
                ))}
              </div>
            </>
          )}

          {result.archive && (
            <pre className="json">
              {JSON.stringify(result.archive, null, 2)}
            </pre>
          )}

          <details>
            <summary>Integrity and processing metadata</summary>
            <pre className="json">
              {JSON.stringify({
                upload_id: result.upload_id,
                mime_type: result.mime_type,
                sha256: result.sha256,
                status: result.analysis_status
              }, null, 2)}
            </pre>
          </details>
        </section>
      )}

      <footer>
        Research support only. Results require qualified human review.
        This prototype does not diagnose, prescribe, or autonomously execute experiments.
      </footer>
    </main>
  );
}

createRoot(document.getElementById("root")!).render(
  <React.StrictMode><App /></React.StrictMode>
);
EOF

