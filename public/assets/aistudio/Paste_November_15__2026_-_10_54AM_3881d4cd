  background: #102b42;
}

.upload-icon {
  font-size: 42px;
  color: #4ce1ff;
}

.dropzone h2 { margin-bottom: 6px; }
.dropzone p, .dropzone small { color: #9eb4c8; }

.upload-button {
  display: inline-block;
  margin: 17px 0;
  padding: 12px 24px;
  background: #16b8d7;
  color: #03121d;
  border-radius: 9px;
  font-weight: 700;
  cursor: pointer;
}

.upload-button input { display: none; }
.selected-file { color: #63e4ff !important; }

.results {
  margin-top: 30px;
  padding: 25px;
  border: 1px solid #203e58;
  border-radius: 16px;
  background: #0a1929;
}

.result-heading h2 { overflow-wrap: anywhere; }
.metrics {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin: 24px 0;
}

.metrics article, .recommendation {
  background: #10243a;
  border: 1px solid #203e58;
  border-radius: 11px;
  padding: 15px;
}

.metrics strong { display: block; margin-top: 8px; font-size: 22px; }
.results h3 { margin-top: 28px; }
.recommendations { display: grid; gap: 10px; }
.recommendation strong { display: block; margin-top: 12px; }
.recommendation p { color: #b0c4d7; line-height: 1.6; }
.priority { display: inline-block; text-transform: uppercase; }
.warning { color: #f3c77a; line-height: 1.6; }
.notice { color: #65e3ff; }
.error { color: #ff8989; }
.json {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: #a9c9e2;
  background: #06101b;
  padding: 14px;
  border-radius: 8px;
}
details { margin-top: 22px; color: #9eb4c8; }
summary { cursor: pointer; }
footer {
  margin-top: 40px;
  color: #718ba4;
  font-size: 12px;
  line-height: 1.7;
  text-align: center;
}

@media (max-width: 600px) {
  .shell { width: min(100% - 24px, 1050px); }
  .hero { padding-top: 48px; }
  .results { padding: 16px; }
  .result-heading { align-items: flex-start; gap: 12px; flex-direction: column; }
}
EOF

