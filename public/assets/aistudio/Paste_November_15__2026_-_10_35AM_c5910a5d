// frontend/src/components/DataMesh.tsx

import { useRef } from "react";
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";

export default function DataMesh({ active }: { active: boolean }) {

  const mesh = useRef<THREE.Mesh>(null);

  useFrame((state, delta) => {

    if (!mesh.current) return;

    mesh.current.rotation.x += delta * 0.12;
    mesh.current.rotation.y += delta * (active ? 0.7 : 0.2);
  });

  return (

    <group>

      <mesh ref={mesh}>

        <torusKnotGeometry args={[1.5, 0.035, 180, 12, 2, 3]} />

        <meshStandardMaterial
          color="#05B6E0"
          emissive="#05B6E0"
          emissiveIntensity={active ? 3 : 0.8}
          wireframe
        />

      </mesh>

      <mesh>
        <icosahedronGeometry args={[0.65, 2]} />
        <meshBasicMaterial
          color="#1FE4F4"
          wireframe
          transparent
          opacity={0.3}
        />
      </mesh>

      {[0, 1, 2, 3, 4, 5].map(index => {

        const angle = index * Math.PI / 3;

        return (
          <mesh
            key={index}
            position={[
              Math.cos(angle) * 2.5,
              Math.sin(angle) * 2.5,
              0
            ]}
          >
            <sphereGeometry args={[0.06, 16, 16]} />
            <meshBasicMaterial color="#1FE4F4" />
          </mesh>
        );
      })}

    </group>
  );
}




// frontend/src/components/ParticleField.tsx

import { useMemo } from "react";
import * as THREE from "three";
import { useFrame } from "@react-three/fiber";
import { useRef } from "react";

export default function ParticleField({
  active
}: {
  active: boolean;
}) {

  const points = useRef<THREE.Points>(null);

  const positions = useMemo(() => {

    const values = new Float32Array(900);

    for (let i = 0; i < values.length; i++) {
      values[i] = (Math.random() - 0.5) * 14;
    }

    return values;

  }, []);

  useFrame((_, delta) => {

    if (points.current) {
      points.current.rotation.y += delta * (active ? 0.12 : 0.025);
    }

  });

  return (

    <points ref={points}>

      <bufferGeometry>
        <bufferAttribute
          attach="attributes-position"
          args={[positions, 3]}
        />
      </bufferGeometry>

      <pointsMaterial
        color="#05B6E0"
        size={0.025}
        transparent
        opacity={0.7}
      />

    </points>
  );
}




// frontend/src/components/SimulationSphere.tsx

import { useFrame } from "@react-three/fiber";
import { useRef } from "react";
import * as THREE from "three";

interface Props {
  progress: number;
  parameters: Record<string, number>;
}

export default function SimulationSphere({
  progress,
  parameters
}: Props) {

  const sphere = useRef<THREE.Mesh>(null);

  useFrame(({ clock }) => {

    if (!sphere.current) return;

    const pulse = 1 + Math.sin(clock.elapsedTime * 2) * 0.035;

    sphere.current.scale.setScalar(
      pulse * (1 + progress * 0.15)
    );

  });

  return (

    <mesh ref={sphere} position={[0, 0, -1]}>

      <sphereGeometry args={[0.9, 32, 32]} />

      <meshPhysicalMaterial
        color="#05B6E0"
        transparent
        opacity={0.08 + progress * 0.15}
        wireframe
        transmission={0.8}
        roughness={0.1}
      />

    </mesh>
  );
}




