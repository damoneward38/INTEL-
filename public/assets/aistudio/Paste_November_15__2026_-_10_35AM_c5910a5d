import { useState } from "react";
import Header from "./components/Header";
import HologramCanvas from "./components/HologramCanvas";
import ControlTower from "./components/ControlTower";
import InsightPanel from "./components/InsightPanel";
import StatusBar from "./components/StatusBar";
import { useResearch } from "./hooks/useResearch";
import { useSimulation } from "./hooks/useSimulation";

export default function App() {

  const research = useResearch();
  const simulation = useSimulation();

  const [language, setLanguage] = useState("en");

  return (
    <div className="intel-app" dir={language === "he" ? "rtl" : "ltr"}>

      <Header
        language={language}
        onLanguageChange={setLanguage}
      />

      <main className="workspace">

        <section className="visual-workspace">

          <HologramCanvas
            active={research.loading || simulation.running}
            simulationProgress={simulation.progress}
            parameters={simulation.parameters}
          />

          <ControlTower
            loading={research.loading}
            onSubmit={research.ask}
            onVoiceResult={research.ask}
            error={research.error}
          />

        </section>

        <InsightPanel
          answer={research.answer}
          sources={research.sources}
          loading={research.loading}
          simulation={simulation}
          onSimulate={simulation.run}
        />

      </main>

      <StatusBar />

    </div>
  );
}




