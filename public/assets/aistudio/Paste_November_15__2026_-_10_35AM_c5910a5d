// frontend/src/hooks/useVoice.ts

import { useState } from "react";

interface SpeechRecognitionResult {
  transcript: string;
  isFinal: boolean;
}

interface RecognitionEvent {
  results: ArrayLike<ArrayLike<SpeechRecognitionResult>>;
}

interface Recognition {
  lang: string;
  continuous: boolean;
  interimResults: boolean;
  onresult: ((event: RecognitionEvent) => void) | null;
  onend: (() => void) | null;
  onerror: (() => void) | null;
  start(): void;
  stop(): void;
}

interface SpeechWindow extends Window {
  SpeechRecognition?: new () => Recognition;
  webkitSpeechRecognition?: new () => Recognition;
}

export function useVoice(onResult: (text: string) => void) {

  const [listening, setListening] = useState(false);

  const Constructor =
    (window as SpeechWindow).SpeechRecognition ||
    (window as SpeechWindow).webkitSpeechRecognition;

  function start() {

    if (!Constructor) return;

    const recognition = new Constructor();

    recognition.lang = "he-IL";
    recognition.continuous = false;
    recognition.interimResults = false;

    recognition.onresult = event => {

      const transcript = Array.from(event.results)
        .map(result => result[0].transcript)
        .join(" ");

      if (transcript.trim()) onResult(transcript);
    };

    recognition.onend = () => setListening(false);
    recognition.onerror = () => setListening(false);

    setListening(true);
    recognition.start();
  }

  return {
    listening,
    supported: Boolean(Constructor),
    start
  };
}




// frontend/src/components/ControlTower.tsx

import { useState } from "react";
import { Settings, Send, Sparkles } from "lucide-react";
import VoiceControl from "./VoiceControl";

interface Props {
  loading: boolean;
  onSubmit: (question: string) => void;
  onVoiceResult: (text: string) => void;
  error: string | null;
}

export default function ControlTower({
  loading,
  onSubmit,
  onVoiceResult,
  error
}: Props) {

  const [query, setQuery] = useState("");
  const [showSettings, setShowSettings] = useState(false);

  function submit() {

    if (!query.trim() || loading) return;

    onSubmit(query.trim());
  }

  return (

    <section className="control-tower">

      <div className="section-heading">
        <Sparkles />
        <h2>COMMAND CENTRAL</h2>

        <button onClick={() => setShowSettings(!showSettings)}>
          <Settings />
        </button>
      </div>

      <textarea
        value={query}
        onChange={event => setQuery(event.target.value)}
        onKeyDown={event => {
          if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            submit();
          }
        }}
        placeholder="Ask anything in English or Hebrew..."
      />

      <div className="command-actions">

        <VoiceControl onResult={onVoiceResult} />

        <button
          className="run-button"
          onClick={submit}
          disabled={loading || !query.trim()}
        >
          <Send />
          {loading ? "PROCESSING..." : "RUN RESEARCH"}
        </button>

      </div>

      {showSettings && (
        <div className="settings-panel">
          <p>Research settings</p>
          <label>
            Evidence depth
            <select>
              <option>Standard</option>
              <option>Deep research</option>
              <option>Comprehensive</option>
            </select>
          </label>
        </div>
      )}

      {error && <p className="error-message">{error}</p>}

    </section>
  );
}




// frontend/src/hooks/useResearch.ts

import { useState } from "react";
import { research } from "../services/api";

export function useResearch() {

  const [answer, setAnswer] = useState("");
  const [sources, setSources] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function ask(question: string) {

    if (!question.trim()) return;

    setLoading(true);
    setError(null);
    setAnswer("");
    setSources([]);

    try {

      const result = await research(question);

      setAnswer(result.answer);
      setSources(result.sources || []);

    } catch {

      setError("Research service unavailable.");

    } finally {

      setLoading(false);
    }
  }

  return {
    answer,
    sources,
    loading,
    error,
    ask
  };
}




// frontend/src/hooks/useSimulation.ts

import { useState } from "react";

export function useSimulation() {

  const [running, setRunning] = useState(false);
  const [progress, setProgress] = useState(0);

  const [parameters, setParameters] = useState({
    temperature: 300,
    steps: 1000,
    pressure: 1
  });

  async function run() {

    setRunning(true);
    setProgress(0);

    try {

      const response = await fetch(
        "http://localhost:8000/api/simulation/run",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            engine: "openmm",
            parameters,
            steps: parameters.steps
          })
        }
      );

      if (!response.ok) {
        throw new Error("Simulation request failed");
      }

      const job = await response.json();

      if (!job.job_id) {
        throw new Error("Simulation service did not return a job ID");
      }

      const socket = new WebSocket(
        `ws://localhost:8000/ws/simulations/${job.job_id}`
      );

      await new Promise<void>((resolve, reject) => {

        socket.onmessage = event => {

          const status = JSON.parse(event.data);

          setProgress(status.progress ?? 0);

          if (status.state === "completed") {
            socket.close();
            resolve();
          }

          if (status.state === "failed") {
            socket.close();
            reject(new Error("Simulation failed"));
          }
        };

        socket.onerror = () => reject(
          new Error("Simulation connection failed")
        );
      });

    } finally {

      setRunning(false);
    }
  }

  return {
    running,
    progress,
    parameters,
    setParameters,
    run
  };
}




