  text-shadow: 0 0 20px #05b6e0;
}

.brand-tagline {
  color: #a8c7df;
  font-size: 13px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-button {
  display: flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: 1px solid #05b6e066;
  border-radius: 8px;
  color: white;
  padding: 10px;
}

.icon-button select {
  background: transparent;
  border: none;
  color: white;
}

.icon-button option {
  color: black;
}

.workspace {
  width: min(1500px, 96%);
  margin: 25px auto;
}

.visual-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(300px, .8fr);
  gap: 20px;
}

.hologram-container {
  height: 500px;
  position: relative;
  border: 1px solid #05b6e066;
  border-radius: 16px;
  overflow: hidden;
  background: radial-gradient(#102a4b, #050d20 75%);
  box-shadow: 0 0 35px #05b6e01a;
}

.hologram-container canvas {
  width: 100%;
  height: 100%;
}

.canvas-label, .canvas-overlay {
  position: absolute;
  z-index: 2;
  left: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
  color: #8bdff0;
  font-size: 10px;
  letter-spacing: 2px;
  pointer-events: none;
}

.canvas-label {
  top: 18px;
}

.canvas-overlay {
  bottom: 18px;
}

.live-indicator {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #888;
}

.live-indicator.active {
  background: #05e6c1;
  box-shadow: 0 0 12px #05e6c1;
}

.control-tower, .insight-card {
  background: #0a193eaa;
  border: 1px solid #05b6e044;
  border-radius: 14px;
  padding: 20px;
}

.control-tower textarea {
  width: 100%;
  min-height: 180px;
  resize: vertical;
  color: white;
  background: #050d20;
  border: 1px solid #05b6e066;
  border-radius: 9px;
  padding: 14px;
  outline: none;
}

.control-tower textarea:focus {
  border-color: #1fe4f4;
  box-shadow: 0 0 15px #05b6e033;
}

.section-heading, .command-actions, .insight-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 18px;
}

.section-heading h2, .insight-header h2 {
  font-size: 14px;
  letter-spacing: 2px;
}

.section-heading svg {
  color: #05b6e0;
}

.run-button, .insight-header button {
  display: flex;
  gap: 8px;
  align-items: center;
  border: none;
  background: #05b6e0;
  color: #001124;
  padding: 12px 18px;
  border-radius: 8px;
  font-weight: 700;
}

.voice-button {
  display: flex;
  gap: 8px;
  align-items: center;
  background: transparent;
  color: white;
  border: 1px solid #05b6e066;
  padding: 12px;
  border-radius: 8px;
}

.voice-button.recording {
  border-color: #ff456e;
  color: #ff456e;
}

.insight-panel {
  margin-top: 25px;
}

.insight-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.insight-card {
  min-height: 280px;
}

.insight-card h3, .evidence-panel h3 {
  color: #05b6e0;
  font-size: 12px;
  letter-spacing: 2px;
}

.research-answer {
  white-space: pre-wrap;
  line-height: 1.8;
  color: #d5e5f5;
}

.loading-state {
  display: flex;
  gap: 12px;
  align-items: center;
  color: #05b6e0;
}

.spinner {
  animation: spin 1s linear infinite;
}

.evidence-panel {
  margin-top: 18px;
  padding: 20px;
  border: 1px solid #05b6e044;
  border-radius: 12px;
  background: #0a193e88;
}

.evidence-item {
  padding: 15px 0;
  border-bottom: 1px solid #05b6e033;
}

.evidence-item p {
  color: #aebed0;
  line-height: 1.6;
}

.evidence-item a {
  color: #1fe4f4;
}

.status-bar {
  display: flex;
  justify-content: space-around;
  gap: 15px;
  padding: 16px;
  border-top: 1px solid #05b6e044;
  color: #8bdff0;
  font-size: 10px;
}

.status-bar span {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-bar svg {
  width: 15px;
}

.error-message {
  color: #ff667d;
}

.settings-panel {
  margin-top: 15px;
  padding: 15px;
  border: 1px solid #05b6e066;
  border-radius: 8px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media(max-width: 850px) {
  .visual-workspace, .insight-grid {
    grid-template-columns: 1fr;
  }

  .hologram-container {
    height: 400px;
  }

  .brand-tagline {
    display: none;
  }

  .status-bar {
    flex-direction: column;
  }
}




