# Server-side Gemini API key (configured in AI Studio Secrets)
GEMINI_API_KEY=

# Optional HMAC secret for session signing (auto-generated ephemerally if omitted)
SESSION_SECRET=

# Optional local Ollama embedding endpoint & model
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional Slack alert bot token & channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#research

# Physical lab equipment execution remains disabled by default
ALLOW_PHYSICAL_EXECUTION=false
